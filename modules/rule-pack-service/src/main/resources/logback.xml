<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="STDOUT_PLAIN" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] req=%X{request_id:-} %logger{30} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="STDOUT_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeMdcKeyName>request_id</includeMdcKeyName>
            <includeMdcKeyName>method</includeMdcKeyName>
            <includeMdcKeyName>path</includeMdcKeyName>
            <includeMdcKeyName>status</includeMdcKeyName>
            <includeMdcKeyName>duration_ms</includeMdcKeyName>
            <includeMdcKeyName>rule_pack_id</includeMdcKeyName>
        </encoder>
    </appender>

    <logger name="app.salary.rulepack" level="INFO"/>
    <logger name="io.javalin" level="INFO"/>
    <logger name="org.eclipse.jetty" level="WARN"/>
    <logger name="com.google.cloud.storage" level="WARN"/>
    <logger name="com.google.cloud.firestore" level="WARN"/>

    <root level="INFO">
        <if condition='"json".equals(System.getenv("LOG_FORMAT"))'>
            <then>
                <appender-ref ref="STDOUT_JSON"/>
            </then>
            <else>
                <appender-ref ref="STDOUT_PLAIN"/>
            </else>
        </if>
    </root>
</configuration>
