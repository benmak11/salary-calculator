<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Lean, high-signal Checkstyle config for the salary-calculator service.
  Deliberately excludes formatting/whitespace/naming/javadoc nitpicks so it can run
  BLOCKING on the existing codebase without a big cleanup. Every rule here flags a
  real correctness or hygiene problem. Tighten over time as desired.
-->
<module name="Checker">
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <!-- No trailing whitespace-only files / tabs handled elsewhere; keep file-level checks minimal. -->
    <module name="SuppressWarningsFilter"/>

    <module name="TreeWalker">
        <module name="SuppressWarningsHolder"/>

        <!-- Imports -->
        <!-- Star imports (esp. static test imports) are pervasive today; report but don't
             block yet. Flip severity to "error" after a one-time cleanup pass. -->
        <module name="AvoidStarImport">
            <property name="severity" value="info"/>
        </module>
        <module name="RedundantImport"/>
        <module name="UnusedImports">
            <property name="processJavadoc" value="true"/>
        </module>
        <module name="IllegalImport"/> <!-- sun.* -->

        <!-- Correctness / bug-prone patterns -->
        <module name="EqualsHashCode"/>
        <module name="CovariantEquals"/>
        <module name="StringLiteralEquality"/>
        <module name="MissingSwitchDefault"/>
        <module name="FallThrough"/>
        <module name="DefaultComesLast"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>
        <module name="EmptyStatement"/>
        <module name="EmptyCatchBlock">
            <property name="exceptionVariableName" value="expected|ignored"/>
        </module>
        <module name="EmptyBlock">
            <property name="option" value="text"/>
            <property name="tokens" value="LITERAL_TRY, LITERAL_FINALLY, LITERAL_IF, LITERAL_ELSE, LITERAL_FOR, LITERAL_WHILE, LITERAL_DO, STATIC_INIT, INSTANCE_INIT"/>
        </module>
        <module name="IllegalThrows"/>
        <module name="EqualsAvoidNull"/>
        <module name="NoFinalizer"/>
        <!-- Non-blocking today (some existing multi-statement test lines); flip to error later. -->
        <module name="OneStatementPerLine">
            <property name="severity" value="info"/>
        </module>
        <module name="MultipleVariableDeclarations"/>

        <!-- Modifiers -->
        <module name="ModifierOrder"/>
        <module name="RedundantModifier"/>

        <!-- Numeric literals -->
        <module name="UpperEll"/>

        <!-- Allow // checkstyle:off style suppression via comments if ever needed -->
        <module name="SuppressionCommentFilter"/>
    </module>
</module>
